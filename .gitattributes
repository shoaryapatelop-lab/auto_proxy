# Normalize all text files to LF in the repository.
* text=auto

# Source / text files
*.cs   text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln  text eol=crlf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=crlf
*.xml  text eol=lf
*.yml  text eol=lf

# Binary files must never be rewritten.
*.ico  binary
*.png  binary
*.jpg  binary