<UserControl x:Class="AutoProxy.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AutoProxy.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogsViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Activity log" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="In-memory and persisted events. Credentials are never written to the log."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Rows}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Level" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LevelText}" Foreground="{Binding LevelBrush}"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Category" Width="110"
                                    DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="Message" Width="360"
                                    DisplayMemberBinding="{Binding Message}"/>
                    <GridViewColumn Header="Detail" Width="320"
                                    DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>