<UserControl x:Class="AutoProxy.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AutoProxy.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Detection endpoints, timing and behaviour."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20"/>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Connectivity check endpoints" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="One URL per line. A 204/200 response means the internet is reachable."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,10"/>
                    <TextBox Text="{Binding ProbeUrls}" AcceptsReturn="True" Height="90"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Text="Custom endpoint (optional)" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding CustomProbeUrl}"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Timing" FontWeight="SemiBold" FontSize="15"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Direct test timeout (s)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox Text="{Binding DirectTimeoutText}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="Proxy test timeout (s)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox Text="{Binding ProxyTimeoutText}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Health check interval (s)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox Text="{Binding HealthCheckIntervalText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Failure threshold (consecutive)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox Text="{Binding FailureThresholdText}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cooldown between re-detections (s)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox Text="{Binding CooldownText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Behaviour" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <CheckBox Content="Start monitoring automatically when AutoProxy launches"
                              IsChecked="{Binding StartMonitoringOnLaunch}"/>
                    <CheckBox Content="Ignore TLS certificate errors when testing proxies"
                              Margin="0,12,0,0" IsChecked="{Binding IgnoreCertificateErrors}"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Windows proxy" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="{Binding ProxyNow, StringFormat='Current: {0}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Restore previous proxy settings"
                            HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding RestorePreviousProxySettingsCommand}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                <Button Style="{StaticResource PrimaryButton}" Content="Save settings"
                        Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource SuccessBrush}" Margin="14,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>