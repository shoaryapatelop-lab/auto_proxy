<UserControl x:Class="AutoProxy.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AutoProxy.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding DetailText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,22"/>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardCaption}" Text="AUTOMATION"/>
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding ModeText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardCaption}" Text="CURRENT NETWORK"/>
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding CurrentNetworkName}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardCaption}" Text="STATUS"/>
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding StatusText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardCaption}" Text="ACTIVE PROXY"/>
                        <TextBlock Style="{StaticResource CardValue}"
                                   Text="{Binding CurrentProxy, TargetNullValue=—}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardCaption}" Text="LATENCY"/>
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding LatencyText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardCaption}" Text="LAST CHECK"/>
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding LastCheckText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Quick actions" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,12"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Manage proxies"
                        Command="{Binding ManageProxiesCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Network profiles"
                        Margin="10,0,0,0" Command="{Binding NetworkProfilesCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="View logs"
                        Margin="10,0,0,0" Command="{Binding ViewLogsCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Settings"
                        Margin="10,0,0,0" Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>